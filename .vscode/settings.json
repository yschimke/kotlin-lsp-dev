  // home directory differs; deleting this file falls back to ~/.local/share/kotlin-lsp-enhanced.
  "kotlinLspDev.serverPath": "/home/yuri/.local/share/kotlin-lsp-263",
  "kotlinLspDev.log": "routing"
}
